{
  "name": "sf-preflight",
  "version": "0.12.0",
  "description": "Preflight checks for Salesforce changes: follows a git diff through flows, triggers, validation rules, roll-ups and permissions to show what it will set off before it ships.",
  "license": "Apache-2.0",
  "author": "sf-preflight contributors",
  "homepage": "https://visparashar.github.io/sf-preflight/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visparashar/sf-preflight.git"
  },
  "bugs": {
    "url": "https://github.com/visparashar/sf-preflight/issues"
  },
  "type": "module",
  "bin": {
    "preflight": "dist/cli.js",
    "sf-preflight": "dist/cli.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "skills",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check . && node scripts/check-license-headers.mjs && node scripts/version.mjs --check",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "analyze:sample": "node dist/cli.js analyze --project fixtures/sample-org --files fixtures/sample-org/force-app/main/default/objects/Opportunity/fields/Contract_Signed_Date__c.field-meta.xml",
    "tests:sample": "node dist/cli.js tests --project fixtures/sample-org --files fixtures/sample-org/force-app/main/default/objects/Opportunity/fields/Contract_Signed_Date__c.field-meta.xml --dry-run",
    "prepack": "npm run clean && npm run build",
    "docs:rules": "npm run build && node -e \"import('./dist/core/rules.js').then((m) => require('node:fs').writeFileSync('docs/RULES.md', m.renderRulesMarkdown()))\""
  },
  "keywords": [
    "salesforce",
    "sfdx",
    "devops",
    "ci",
    "impact-analysis",
    "static-analysis",
    "order-of-execution",
    "flows",
    "apex",
    "agentforce",
    "mcp"
  ],
  "dependencies": {
    "@apexdevtools/apex-parser": "^5.2.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "fast-check": "4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
